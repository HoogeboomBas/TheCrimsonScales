<Project Sdk="Godot.NET.Sdk/4.7.1">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <RunSettingsFilePath>$(MSBuildProjectDirectory)/test.runsettings</RunSettingsFilePath>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Game.csproj" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="gdUnit4.api" Version="5.1.0-rc6" />
        <PackageReference Include="gdUnit4.test.adapter" Version="3.2.0" PrivateAssets="all" />
    </ItemGroup>
    <!-- Keep resource paths identical to the game while referencing its compiled assembly.
         These incremental copies are local build output, not another copy of game source in Git. -->
    <ItemGroup>
        <GameResource Include="../Art/**/*"><TargetRoot>Art/</TargetRoot></GameResource>
        <GameResource Include="../Content/**/*"><TargetRoot>Content/</TargetRoot></GameResource>
        <GameResource Include="../Fonts/**/*"><TargetRoot>Fonts/</TargetRoot></GameResource>
        <GameResource Include="../GTweensGodot/**/*"><TargetRoot>GTweensGodot/</TargetRoot></GameResource>
        <GameResource Include="../Materials/**/*"><TargetRoot>Materials/</TargetRoot></GameResource>
        <GameResource Include="../Resources/**/*"><TargetRoot>Resources/</TargetRoot></GameResource>
        <GameResource Include="../Scenes/**/*"><TargetRoot>Scenes/</TargetRoot></GameResource>
        <GameResource Include="../Scripts/**/*"><TargetRoot>Scripts/</TargetRoot></GameResource>
        <GameResource Include="../Shaders/**/*"><TargetRoot>Shaders/</TargetRoot></GameResource>
        <GameResource Include="../addons/**/*"><TargetRoot>addons/</TargetRoot></GameResource>
        <GameRootResource Include="../default_bus_layout.tres;../icon.svg;../icon.svg.import;../cs-crimson-scales-icon.png;../cs-crimson-scales-icon.png.import" />
        <GameResource Include="@(GameRootResource)" />
        <GameResourceDirectory Include="Art;Content;Fonts;GTweensGodot;Materials;Resources;Scenes;Scripts;Shaders;addons" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="**/*.cs"
                 Exclude="$(DefaultItemExcludes);.godot/**;obj/**;bin/**;@(GameResourceDirectory->'%(Identity)/**')" />
    </ItemGroup>
    <Target Name="PrepareGodotTestResources" BeforeTargets="BeforeBuild">
        <Copy SourceFiles="@(GameResource)"
              DestinationFiles="@(GameResource->'$(MSBuildProjectDirectory)/%(TargetRoot)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>
    <Target Name="CleanGodotTestResources" AfterTargets="Clean">
        <RemoveDir Directories="@(GameResourceDirectory->'$(MSBuildProjectDirectory)/%(Identity)')" />
        <Delete Files="@(GameRootResource->'$(MSBuildProjectDirectory)/%(Filename)%(Extension)')" />
    </Target>
</Project>
